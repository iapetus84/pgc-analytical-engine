-- Create H8 visualization data: Auto renewal rate by acquisition year and product group

CREATE OR REPLACE TABLE
  `@gcp_project.@gold_data_set.h8_ar_cohort_trend` AS

WITH cohorts AS (
  SELECT
    EXTRACT(YEAR FROM s.started_at)                AS acquisition_year,           -- start date determing the analyzed cohort
    s.product_group,
    COUNT(*)                                       AS total_subscriptions,
    COUNTIF(p.ar_valid_to = s.ended_at)            AS always_on,                  -- users who consciously kept the auto-renew
    COUNTIF(p.ar_valid_to < s.ended_at)            AS disabled_mid,               -- users who disabled auto-renew before the end of subscription
    COUNTIF(p.subscription_id IS NULL)             AS never_touched               -- users who never touched the auto-renew toggle don't exist in auto_renew_periods

  FROM `@gcp_project.@silver_data_set.subscriptions` s
  LEFT JOIN `pgc-analytical-engine.rec_hstg_silver.auto_renew_periods` p
         ON s.subscription_id = p.subscription_id
        AND p.toggle_sequence = 1                                                 -- selecting only the first toggle action
  
  WHERE NOT (s.product_group = 'mail'                                             -- Exclude mail 2021: launch artifact (104 subscriptions, 96% never touched)
        AND EXTRACT(YEAR FROM s.started_at) = 2021)
  GROUP BY acquisition_year, s.product_group
)

SELECT
  acquisition_year,
  product_group,
  total_subscriptions,
  always_on,
  disabled_mid,
  never_touched,
  
  ROUND(always_on / total_subscriptions, 4)        AS ar_rate_snapshot,         -- Snapshot rate: primary metric for trend comparison

  ROUND(
    always_on / total_subscriptions
    - LAG(always_on / total_subscriptions)
      OVER (PARTITION BY product_group ORDER BY acquisition_year)
  , 4)                                             AS ar_rate_yoy_change,       -- YoY change: NULL for first year per product group (no prior year)

FROM cohorts
ORDER BY product_group, acquisition_year;
